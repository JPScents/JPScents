# Local Docker-backed Supabase and Prisma configuration.
# Copy to .env.local. Obtain the local keys from Supabase CLI output without
# committing them. Never expose the secret key to browser code.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:56322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:56322/postgres"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:56321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-local-publishable-key"
SUPABASE_SECRET_KEY="replace-with-local-secret-or-service-role-key"
JP_SCENTS_ADMIN_EMAIL="jpscents23@gmail.com"
# Optional temporary operator access; remove and redeploy to revoke it.
JP_SCENTS_SECONDARY_ADMIN_EMAIL="freemanmadudili@gmail.com"
# Non-secret client-confirmed business recipient used only for post-order WhatsApp handoff.
JP_SCENTS_WHATSAPP_NUMBER="replace-with-client-confirmed-number"
