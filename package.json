{
  "name": "codebase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:demo": "prisma db seed",
    "admin:provision": "node scripts/provision-admin.mjs",
    "env:check": "node scripts/check-environment.mjs",
    "env:check:production": "node scripts/check-environment.mjs --production",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local --no-seed && npm run db:migrate:deploy",
    "supabase:reset:demo": "npm run supabase:reset && npm run db:seed:demo",
    "setup:local": "npm run supabase:start && npm run supabase:reset",
    "setup:local:demo": "npm run setup:local && npm run db:seed:demo",
    "release:check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run db:validate && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.1.0",
    "prettier": "^3.9.6",
    "prisma": "7.9.1",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
